# Copy this file to .env and fill it in. Never commit .env itself.

# Database (Postgres.app usually runs on 5433; a Homebrew install on 5432)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=health
DB_USER=your_mac_username
DB_PASSWORD=

# Login tokens. After copying, run:  python3 harden_config.py
# It replaces these placeholders with long random secrets automatically.
SECRET_KEY=replace_with_a_long_random_string
JWT_SECRET=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: real AI replies for Nia. Leave blank to use the built-in
# rule-based replies. Needs a funded key from console.anthropic.com.
ANTHROPIC_API_KEY=

# true  = verification and reset codes are shown on screen (demo only)
# false = codes are never returned by the API (use before real patients)
DEV_MODE=true
